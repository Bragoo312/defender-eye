# Binaries and build artifacts
bin/*
!bin/defender-eye-linux-amd64
!bin/defender-eye-linux-arm64
/dist/
!internal/web/dist/**
build/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test and coverage artifacts
*.test
*.out
coverage.txt

# Defender Eye local runtime data
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.log

# Sensitive configs & keys
*.pem
*.key
*.pub
configs/server_rsa.*
configs/config.yaml
